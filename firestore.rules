rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "MASTER_ADMIN";
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isMasterAdmin());
      allow list: if isMasterAdmin();

      allow create: if signedIn()
        && (
          (
            request.auth.uid == userId
            && request.auth.token.email.lower() == "basheer222@gmail.com"
            && request.resource.data.role == "MASTER_ADMIN"
          )
          || isMasterAdmin()
        );

      allow update: if isMasterAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
        );

      allow delete: if isMasterAdmin();
    }


    match /app_installations/{deviceId} {
      // Driver/test devices use anonymous auth only to register and update their
      // own installation record. Master Admin can read the fleet registry.
      allow create: if signedIn()
        && request.resource.data.deviceId == deviceId
        && request.resource.data.ownerUid == request.auth.uid
        && (
          request.auth.token.firebase.sign_in_provider == "anonymous"
          || isMasterAdmin()
        );

      allow update: if signedIn()
        && request.resource.data.deviceId == deviceId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          request.auth.uid == resource.data.ownerUid
          || isMasterAdmin()
        );

      allow get, list: if isMasterAdmin();
      allow delete: if isMasterAdmin();
    }


    match /trip_assignments/{assignmentId} {
      // Master Admin creates a universal/open trip; no driver is selected.
      allow create: if isMasterAdmin()
        && request.resource.data.assignmentId == assignmentId
        && request.resource.data.status == "ASSIGNED"
        && request.resource.data.otpHash == assignmentId;

      // Drivers can fetch a trip only by its OTP-derived document ID.
      // Collection listing remains unavailable to drivers.
      allow get: if isMasterAdmin()
        || (
          signedIn()
          && request.auth.token.firebase.sign_in_provider == "anonymous"
          && resource.data.status in ["ASSIGNED", "CLAIMED", "STARTED", "COMPLETED"]
        );

      allow list: if isMasterAdmin();

      // First successful claim wins.
      allow update: if isMasterAdmin()
        || (
          signedIn()
          && request.auth.token.firebase.sign_in_provider == "anonymous"
          && resource.data.status == "ASSIGNED"
          && request.resource.data.status == "CLAIMED"
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.claimedByUid == request.auth.uid
          && request.resource.data.deviceId is string
          && request.resource.data.assignmentId == resource.data.assignmentId
          && request.resource.data.otpHash == resource.data.otpHash
        )
        || (
          signedIn()
          && request.auth.token.firebase.sign_in_provider == "anonymous"
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status == "CLAIMED"
          && request.resource.data.status == "STARTED"
          && request.resource.data.startedByUid == request.auth.uid
        )
        || (
          signedIn()
          && request.auth.token.firebase.sign_in_provider == "anonymous"
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status == "STARTED"
          && request.resource.data.status == "COMPLETED"
          && request.resource.data.completedByUid == request.auth.uid
        );

      allow delete: if isMasterAdmin();
    }

    match /completed_trips/{tripId} {
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider == "anonymous"
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "COMPLETED";
      allow get, list: if isMasterAdmin()
        || (
          signedIn()
          && request.auth.token.firebase.sign_in_provider == "anonymous"
          && resource.data.ownerUid == request.auth.uid
        );
      allow update, delete: if isMasterAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
