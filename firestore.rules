rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "MASTER_ADMIN";
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isMasterAdmin());
      allow list: if isMasterAdmin();

      allow create: if signedIn()
        && (
          (
            request.auth.uid == userId
            && request.auth.token.email.lower() == "basheer222@gmail.com"
            && request.resource.data.role == "MASTER_ADMIN"
          )
          || isMasterAdmin()
        );

      allow update: if isMasterAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
        );

      allow delete: if isMasterAdmin();
    }


    match /app_installations/{deviceId} {
      // Driver/test devices use anonymous auth only to register and update their
      // own installation record. Master Admin can read the fleet registry.
      allow create: if signedIn()
        && request.resource.data.deviceId == deviceId
        && request.resource.data.ownerUid == request.auth.uid
        && (
          request.auth.token.firebase.sign_in_provider == "anonymous"
          || isMasterAdmin()
        );

      allow update: if signedIn()
        && request.resource.data.deviceId == deviceId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          request.auth.uid == resource.data.ownerUid
          || isMasterAdmin()
        );

      allow get, list: if isMasterAdmin();
      allow delete: if isMasterAdmin();
    }


    match /trip_assignments/{assignmentId} {
      // Only the Master Admin can create/manage assignments.
      allow create: if isMasterAdmin()
        && request.resource.data.assignmentId == assignmentId
        && request.resource.data.ownerUid is string
        && request.resource.data.deviceId is string
        && request.resource.data.status == "ASSIGNED";

      // Admin can inspect assignments. A driver can query only assignments
      // explicitly owned by its anonymous Firebase UID.
      allow get: if isMasterAdmin()
        || (
          signedIn()
          && request.auth.token.firebase.sign_in_provider == "anonymous"
          && resource.data.ownerUid == request.auth.uid
        );

      allow list: if isMasterAdmin()
        || (
          signedIn()
          && request.auth.token.firebase.sign_in_provider == "anonymous"
          && request.query.limit <= 10
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status == "ASSIGNED"
        );

      // Driver may only claim its own assigned trip; ownership and device
      // cannot be changed by the driver.
      allow update: if isMasterAdmin()
        || (
          signedIn()
          && request.auth.token.firebase.sign_in_provider == "anonymous"
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.deviceId == resource.data.deviceId
          && resource.data.status == "ASSIGNED"
          && request.resource.data.status == "CLAIMED"
          && request.resource.data.claimedByUid == request.auth.uid
        );

      allow delete: if isMasterAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
